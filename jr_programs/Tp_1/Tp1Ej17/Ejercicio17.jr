import java.util.*;

public class Ejercicio17 {

    // El arreglo debe ser estático para ser compartido o pasado a procesos
    // estáticos
    private static int[] numeros = new int[10];

    // Función para llenar el arreglo
    static{
        Random rand = new Random();
        System.out.println("--- Cargando el arreglo ---");
        for (int i = 0; i < numeros.length; i++) {
            numeros[i] = rand.nextInt(100);
            if (i % 2 == 0){
            System.out.println("Posicion " + i + " PAR cargada con: " + numeros[i]);
            } 
            else {
            System.out.println("Posicion " + i + " IMPAR cargada con: " + numeros[i]);
            }
        }
        System.out.println("--- Arreglo listo ---");
    }

    public static process mayorPares
    {
    int mayor = -1;

    for(int i = 0;i<numeros.length;i++)
    {
        if (i % 2 == 0) {
            if (mayor < numeros[i])
                mayor = numeros[i];
        }
        System.out.println("mayorPares = " + mayor);
    }}

    public static process mayorImpares{
        int mayor = -1;
        for(int i = 0;i<numeros.length;i++)
        {
            if (i % 2 != 0) {
                if (mayor < numeros[i])
                    mayor = numeros[i];
            }
            System.out.println("mayorImpares = " + mayor);
        }
    }


    public static void main(String[] args) {

    }
}