import java.util.Random;

public class Ejercicio17 {

    // El arreglo debe ser estático para ser compartido o pasado a procesos estáticos
    private static int[] miArreglo = new int[10];

    // Función para llenar el arreglo
    public static void llenarArreglo(int[] arr) {
        Random rand = new Random();
        System.out.print("Arreglo generado: ");
        for (int i = 0; i < arr.length; i++) {
            arr[i] = rand.nextInt(100) + 1; // Números entre 1 y 100
            System.out.print(arr[i] + " ");
        }
        System.out.println("\n-------------------------------");
    }

    // En JR, si usas parámetros en un proceso, necesitas una 'op' o invocarlo
    // Aquí los definimos sin parámetros para que usen el arreglo estático directamente
    static process mayorPares {
        int mayor = -1; // Iniciamos en -1 por si hay ceros
        for (int i = 0; i < miArreglo.length; i++) {
            if (miArreglo[i] % 2 == 0) { // Sintaxis correcta del módulo
                if (miArreglo[i] > mayor) {
                    mayor = miArreglo[i];
                }
            }
        }
        if (mayor != -1)
            System.out.println("El mayor de los PARES es: " + mayor);
        else
            System.out.println("No se encontraron números pares.");
    }

    static process mayorImpares {
        int mayor = -1;
        for (int i = 0; i < miArreglo.length; i++) { // Corregido 'length'
            if (miArreglo[i] % 2 != 0) {
                if (miArreglo[i] > mayor) {
                    mayor = miArreglo[i];
                }
            }
        }
        if (mayor != -1)
            System.out.println("El mayor de los IMPARES es: " + mayor);
        else
            System.out.println("No se encontraron números impares.");
    }

    public static void main(String[] args) {
        // Llenamos el arreglo antes de que los procesos hagan sus cálculos
        // Nota: En JR los procesos estáticos arrancan casi de inmediato.
        llenarArreglo(miArreglo);
    }
}