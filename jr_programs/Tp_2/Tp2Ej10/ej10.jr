package jr_programs.Tp_2.Tp2Ej10;

public class ej10 {

    // OLD: public boolean ocupada = false;
    public boolean barberoLibre = true;

    // OLD: public sem clientes = 0;
    public sem despertar = 0;

    // OLD: public int sillasLibres = 5;
    public int sillasLibres = 5;

    public sem mutex = 1;

    // OLD: public sem cliespera = 0;
    public sem llamar = 0;

    public sem corteTerminado = 0;

    public process barbero() {
        while (true) {
            // OLD: P(clientes);
            P(despertar);

            System.out.println("Barbero cortando pelo");

            // OLD: System.out.println("Llega el cliente y le corto");
            // OLD: P(mutex);
            // OLD: ocupada=false;
            // OLD:     if (sillasLibres<5){
            // OLD:         System.out.println("Hay sillas ocupadas, llamo al cliente");
            // OLD:         V(cliespera);
            // OLD:         sillasLibres++;
            // OLD:     }
            // OLD: V(mutex);

            V(corteTerminado);

            P(mutex);
            if (sillasLibres < 5) {
                sillasLibres++;
                V(llamar);
                V(mutex);
            } else {
                barberoLibre = true;
                V(mutex);
            }
        }
    }

    public process cliente((int i = 0; i < 10; i++)) {
        P(mutex);

        // OLD: if (!ocupada){
        if (barberoLibre) {
            // OLD: System.out.println("Silla libre, me corto el lope");
            // OLD: ocupada=true;
            // OLD: V(mutex);
            // OLD: V(clientes);
            barberoLibre = false;
            V(mutex);
            V(despertar);
            P(corteTerminado);
            System.out.println("Cliente " + i + " se va");
        }
        // OLD: else if (sillasLibres<=5 && sillasLibres>0){
        else if (sillasLibres > 0) {
            // OLD: System.out.println("Hay lugar pero tengo q esperar");
            // OLD: sillasLibres--;
            // OLD: V(mutex);
            // OLD: P(cliespera);
            // OLD: V(clientes);
            sillasLibres--;
            V(mutex);
            P(llamar);
            V(despertar);
            P(corteTerminado);
            System.out.println("Cliente " + i + " se va");
        }
        else {
            System.out.println("No hay lugar me voy");
            V(mutex);
        }
    }
}
